<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header>
      <nav>
        <div class="logo" id="navLogo">AI社畜評論家</div>
        <ul class="nav-links">
          <li><a href="/" id="navHome">ホーム</a></li>
          <li><a href="/square" class="active" id="navSquare">社畜広場</a></li>
          <li><a href="/history" id="navHistory">履歴</a></li>
          <li><a href="/contact" id="navContact">お問い合わせ</a></li>
        </ul>
        <div class="lang-switcher">
          <button id="langJa" class="lang-btn active">日本語</button>
          <button id="langZh" class="lang-btn">中文</button>
        </div>
      </nav>
    </header>

    <main>
      <div class="hero">
        <h1 class="title" id="squarePageTitle">社畜広場 🏢</h1>
        <p class="subtitle" id="squarePageSubtitle">みんなの日常とAIの容赦ない評価・魂の反論をのぞいてみよう！</p>
      </div>

      <div class="square-section">
        <div class="square-controls">
          <button id="refreshSquareBtn" class="btn-secondary" style="max-width: 240px; margin: 0 0 20px auto;">🔄 最新の投稿を読み込む</button>
        </div>

        <div id="squareList" class="square-list">
          <!-- 广场内容会动态加载在这里 -->
        </div>

        <div id="emptySquare" class="empty-state" style="display: none;">
          <div class="empty-icon">☕</div>
          <p id="squareEmptyText">まだ広場への投稿がありません。ホームで評価を生成してみましょう！</p>
          <a href="/" class="btn-primary" style="max-width: 240px; display: inline-block; text-decoration: none;">評価を生成する</a>
        </div>
      </div>
    </main>

    <footer>
      <p id="footerText">&copy; 2026 AI社畜評論家. All rights reserved.</p>
    </footer>
  </div>

  <script src="/js/i18n.js"></script>
  <script src="/js/square.js"></script>
</body>
</html>
