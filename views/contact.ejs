<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header>
      <nav>
        <div class="logo" id="navLogo">AI社畜評論家</div>
        <ul class="nav-links">
          <li><a href="/" id="navHome">ホーム</a></li>
          <li><a href="/history" id="navHistory">履歴</a></li>
          <li><a href="/contact" class="active" id="navContact">お問い合わせ</a></li>
        </ul>
        <div class="lang-switcher">
          <button id="langJa" class="lang-btn active">日本語</button>
          <button id="langZh" class="lang-btn">中文</button>
        </div>
      </nav>
    </header>

    <main>
      <div class="hero">
        <h1 class="title" id="pageTitle">お問い合わせ</h1>
        <p class="subtitle" id="pageSubtitle">ご意見・ご要望をお聞かせください</p>
      </div>

      <div class="contact-section">
        <form id="contactForm" class="contact-form">
          <div class="form-group">
            <label for="name" id="labelName">お名前 <span class="required">*</span></label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="山田太郎"
            >
          </div>

          <div class="form-group">
            <label for="email" id="labelEmail">メールアドレス <span class="required">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="example@example.com"
            >
          </div>

          <div class="form-group">
            <label for="message" id="labelMessage">お問い合わせ内容 <span class="required">*</span></label>
            <textarea
              id="message"
              name="message"
              rows="8"
              required
              placeholder="お問い合わせ内容をご記入ください"
            ></textarea>
          </div>

          <div id="contactError" class="error-message"></div>
          <div id="contactSuccess" class="success-message" style="display: none;"></div>

          <button type="submit" class="btn-primary" id="submitBtn">送信する</button>
        </form>
      </div>
    </main>

    <footer>
      <p id="footerText">&copy; 2026 AI社畜評論家. All rights reserved.</p>
    </footer>
  </div>

  <script src="/js/i18n.js"></script>
  <script src="/js/contact.js"></script>
</body>
</html>
