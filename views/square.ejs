<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header>
      <nav>
        <div class="logo" id="navLogo">AI社畜評論家</div>
        <ul class="nav-links">
          <li><a href="/" id="navHome">ホーム</a></li>
          <li><a href="/square" class="active" id="navSquare">社畜広場</a></li>
          <li><a href="/history" id="navHistory">履歴</a></li>
          <li><a href="/contact" id="navContact">お問い合わせ</a></li>
        </ul>
        <div class="lang-switcher">
          <button id="langJa" class="lang-btn active">日本語</button>
          <button id="langZh" class="lang-btn">中文</button>
        </div>
      </nav>
    </header>

    <main>
      <div class="hero">
        <h1 class="title" id="squarePageTitle">社畜広場 🏢</h1>
        <p class="subtitle" id="squarePageSubtitle">社畜たちによる仕事の本音・評価の共有スペース。誰でも匿名でコメント・共感できます！</p>
      </div>

      <!-- 发布我的工作心声/评价卡片 -->
      <div class="square-post-card">
        <h3 class="square-post-title" id="squarePublishTitle">自分の仕事・今日の一日を評価して共有する</h3>
        
        <div class="post-meta-inputs">
          <input type="text" id="postAuthorInput" class="post-input" placeholder="ニックネーム（省略可：匿名社畜）" maxlength="20">
          <input type="text" id="postJobInput" class="post-input" placeholder="職種 / 役職（例：エンジニア、営業、事務...）" maxlength="20">
        </div>

        <div class="work-rating-row">
          <span class="work-rating-label" id="squareWorkRatingLabel">自分の仕事に対する自己評価：</span>
          <div class="work-stars-select" id="workStarsSelect">
            <span class="work-star" data-rating="1">★</span>
            <span class="work-star" data-rating="2">★</span>
            <span class="work-star active" data-rating="3">★</span>
            <span class="work-star" data-rating="4">★</span>
            <span class="work-star" data-rating="5">★</span>
          </div>
          <span id="workStarText" class="work-star-text">★★★ (3点)</span>
        </div>

        <textarea id="postContentInput" class="post-textarea" rows="3" maxlength="300" placeholder="仕事に対する本音や評価、悩み、社畜あるあるを書いてみよう（300文字以内）..."></textarea>
        
        <div class="post-action-row">
          <div id="squarePostNotice" class="square-post-notice" style="display: none;"></div>
          <button id="publishPostBtn" class="btn-primary" style="margin-top: 0; width: auto; min-width: 160px; padding: 10px 24px;">広場に投稿する</button>
        </div>
      </div>

      <div class="square-section">
        <div class="square-controls">
          <button id="refreshSquareBtn" class="btn-secondary">🔄 最新の投稿を読み込む</button>
        </div>

        <div id="squareList" class="square-list">
          <!-- 广场动态列表 -->
        </div>

        <div id="emptySquare" class="empty-state" style="display: none;">
          <div class="empty-icon">☕</div>
          <p id="squareEmptyText">まだ広場への投稿がありません。最初の投稿をしてみましょう！</p>
        </div>
      </div>
    </main>

    <footer>
      <p id="footerText">&copy; 2026 AI社畜評論家. All rights reserved.</p>
    </footer>
  </div>

  <script src="/js/i18n.js"></script>
  <script src="/js/square.js"></script>
</body>
</html>
