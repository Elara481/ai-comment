<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header>
      <nav>
        <div class="logo" id="navLogo">AI社畜評論家</div>
        <ul class="nav-links">
          <li><a href="/" id="navHome">ホーム</a></li>
          <li><a href="/history" class="active" id="navHistory">履歴</a></li>
          <li><a href="/contact" id="navContact">お問い合わせ</a></li>
        </ul>
        <div class="lang-switcher">
          <button id="langJa" class="lang-btn active">日本語</button>
          <button id="langZh" class="lang-btn">中文</button>
        </div>
      </nav>
    </header>

    <main>
      <div class="hero">
        <h1 class="title" id="pageTitle">評価履歴</h1>
        <p class="subtitle" id="pageSubtitle">過去の評価を振り返りましょう</p>
      </div>

      <div class="history-section">
        <div class="history-controls">
          <button id="clearHistoryBtn" class="btn-danger">履歴をすべて削除</button>
        </div>

        <div id="historyList" class="history-list">
          <!-- 履歴がここに表示されます -->
        </div>

        <div id="emptyHistory" class="empty-state" style="display: none;">
          <div class="empty-icon">📝</div>
          <p id="emptyText">まだ評価履歴がありません</p>
          <a href="/" class="btn-secondary" id="goHomeBtn">評価を生成する</a>
        </div>
      </div>
    </main>

    <footer>
      <p id="footerText">&copy; 2026 AI社畜評論家. All rights reserved.</p>
    </footer>
  </div>

  <script src="/js/i18n.js"></script>
  <script src="/js/history.js"></script>
</body>
</html>
